DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/hbc
# development | test | production
ENVIRONMENT=development
DEBUG=false
# Comma-separated list of allowed browser origins (or a JSON array).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# Required in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
# Demo wallet balance in paisa (100000000 paisa = Rs 10,00,000)
DEMO_BALANCE_PAISA=100000000
# One-time admin bootstrap, used by:
#   python -m src.auth.create_admin
# Existing users are promoted; otherwise a new superuser is created.
# Remove ADMIN_PASSWORD after creating the admin.
# ADMIN_EMAIL=admin@example.com
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-strong-password
